{
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.includePath": ["${workspaceFolder}/include", "${workspaceFolder}/src"],
    "files.exclude": {
        "build": true,
        "node_modules": true,
        "coverage": true
    }
}
